# Copy to .env and fill in. .env is git-ignored; this template is not, so it
# must never carry a real value.
#
#     cp .env.template .env
#     source scripts/load-env.fish        # fish
#     set -a; . ./.env; set +a            # bash/zsh
#
# refereekit itself reads only the environment, never this file: a password in
# a CLI flag lands in shell history and the process table, and a password in a
# file the tool parses is one path-traversal away from being read by something
# else. Loading is the shell's job.

# --- OpenReview (refereekit or-fetch) ---
# The account the paper is assigned to. Both are required; an empty value is
# rejected the same as an absent one.
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# --- LLM backend (refereekit draft / editor / review / or-draft) ---
# Set to 1 to confirm the backend runs under zero-retention terms. Without it
# the manuscript path refuses to send anything.
#
# Zero-retention terms are not a blanket permission: a venue may forbid outside
# models however well the transport behaves. That rule is no longer enforced by
# remembering to leave this unset — see REFEREEKIT_VENUE_POLICY below — because
# a shell that reviewed a journal paper an hour ago still has it set.
REFEREEKIT_ZERO_RETENTION=

# Optional TOML file listing venues that forbid sending the submission to any
# outside model. It extends and overrides a built-in table which currently
# carries one entry, NeurIPS, matched against both the bare name and the
# OpenReview id. Commands that would send manuscript text read the venue from
# --venue or from the session state or-fetch recorded, and refuse before a
# backend is built. Unlisted venues are permitted: code cannot know every
# venue's policy, and refusing the unknown would make the tool useless for the
# long tail of journals. Keeping this table current is the referee's job.
#
#     [venues]
#     "Some Journal" = { llm = false }
#     NeurIPS = { llm = true }        # if the rule ever changes
REFEREEKIT_VENUE_POLICY=

# Which deployment of the Anthropic SDK carries the manuscript: "anthropic"
# (default), "bedrock", or "vertex". A name that is not registered is refused
# rather than quietly treated as the default, because a typo would otherwise
# send the manuscript somewhere the referee did not choose.
#
# On the cloud deployments the provider rather than Anthropic is the data
# processor, so Anthropic's retention terms do not govern the request;
# REFEREEKIT_ZERO_RETENTION is then an attestation about that account's own
# logging settings. Region, project and credentials are read by the SDK from
# the provider's usual environment variables and never by refereekit.
REFEREEKIT_BACKEND=

# Model id. Defaults per deployment when unset, since each names the same model
# differently, but only where that id has been run against that deployment. A
# deployment with no confirmed default refuses and asks for this rather than
# shipping a guess; "vertex" is in that state today. A value set here must match
# the deployment in use.
REFEREEKIT_MODEL=

# Read by the anthropic SDK directly, not by refereekit. Needed only on the
# "anthropic" deployment.
ANTHROPIC_API_KEY=

# --- Bedrock deployment only ---
# Read by the AWS SDK, not by refereekit, exactly as any other AWS tool reads
# them. An SSO-based profile also needs the CRT extra:
#     pip install "botocore[crt]"
AWS_REGION=
AWS_PROFILE=

# --- Offline testing ---
# Set to 1 to use the fake backend, which returns canned text and calls no API.
REFEREEKIT_FAKE=
REFEREEKIT_FAKE_TEXT=

# Path to a style guide; defaults to style/STYLE.md.
REFEREEKIT_STYLE=
