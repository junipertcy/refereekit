# Confidential manuscripts under review, and text derived from them, must never
# enter the repository. Patterns are root-anchored so the test fixture under
# tests/fixtures/ is NOT caught.

# Manuscript PDFs (live in repo root)
/*.pdf
# Extracted manuscript text
/*_raw.txt
/*_plain.txt
# Per-review outputs (manuscript-derived)
/review_draft_*.txt
/editor_response_*.txt
/index.html

# Env / caches / vendored study code
.venv/
__pycache__/
*.pyc
# Locally-cloned reference code studied during a review (never committed)
*_study/
.superpowers/

# Root-level exploration scripts (one-off tooling superseded by refereekit package).
# Never committed.
/analyze.py
/audit.py
/by_section.py
/count_para.py
/count_para2.py
/*_demo.py
/diag.py
/diag2.py
/errbar.py
/fig8.py
/fig8body.py
/figcheck.py
/final_count.py
/headers.py
/locate.py
/locate2.py
/locate3.py
/para_full.py
/sweep.py
/topnum.py
/verify_all.py
/verify_indent.py
/verify_p16.py
/verify2.py
/verify3.py

# Python editable-install metadata
*.egg-info/
# LaTeX fixture build artifacts (the .pdf is committed; these are not)
tests/fixtures/*.aux
tests/fixtures/*.log

# Per-review working directories (never committed)
/work/
