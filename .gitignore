# Confidential manuscripts under review, and text derived from them, must never
# enter the repository.
#
# Deny everywhere, then allow this repository's own files by name. These
# patterns were once anchored to the root, which protected the test fixtures by
# accident of position and left anything one directory down committable by
# `git add -A`: a session directory, docs/, a scratch folder. An allow-list of
# three files is auditable; a deny-list of "wherever a manuscript might land"
# cannot be. tests/test_gitignore.py pins both halves.

# Manuscript PDFs, anywhere. The suite's own inputs are the only exception.
*.pdf
!tests/fixtures/*.pdf

# Text extracted from, or derived from, a manuscript.
*_raw.txt
*_plain.txt
review_draft_*.txt
editor_response_*.txt

# Rendered Q&A pages. --session takes any path, so a session is not always
# under work/; diagrams/index.html is documentation that shares the name.
index.html
!diagrams/index.html

# Env / caches / vendored study code
.venv/
# Credentials. .env holds a real OpenReview password; only .env.template,
# which carries names and no values, is committed. Listed before the .venv/
# glob would suggest otherwise: .venv/ does not match .env.
.env
.env.*
!.env.template
__pycache__/
*.pyc
# Locally-cloned reference code studied during a review (never committed)
*_study/
.superpowers/

# Root-level exploration scripts (one-off tooling superseded by refereekit package).
# Never committed.
/analyze.py
/audit.py
/by_section.py
/count_para.py
/count_para2.py
/*_demo.py
/diag.py
/diag2.py
/errbar.py
/fig8.py
/fig8body.py
/figcheck.py
/final_count.py
/headers.py
/locate.py
/locate2.py
/locate3.py
/para_full.py
/sweep.py
/topnum.py
/verify_all.py
/verify_indent.py
/verify_p16.py
/verify2.py
/verify3.py

# Python editable-install metadata
*.egg-info/
# LaTeX fixture build artifacts (the .pdf is committed; these are not)
tests/fixtures/*.aux
tests/fixtures/*.log

# Per-review working directories (never committed)
/work/
